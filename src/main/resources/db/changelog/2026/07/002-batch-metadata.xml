<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-batch-metadata-mrg" author="dcre">
        <!-- A-81: the sqlFile gained IF NOT EXISTS on every CREATE, which CHANGES this
             changeset's checksum and would fail validation on every database that had
             already executed it ("was: 9:6745... but is now: 9:fcef..."), observed live on
             MRR. Liquibase's documented escape hatch is the right one here rather than a
             new id per service: the content is autogenerated framework DDL whose integrity
             is now guaranteed by the IF NOT EXISTS clauses themselves, so re-running it
             cannot damage a database in any state. Applying it is what must stay possible;
             the byte-for-byte checksum is not the control that matters for this file. -->
        <validCheckSum>ANY</validCheckSum>
        <!-- LIQUIBASE-SQL-EXCEPTION: this is the AUTOGENERATED Spring Batch 6 metadata DDL
             (batch-metadata-mrg.sql), loaded verbatim as a vendored file with the MRG_BATCH_
             prefix + EXIT_MESSAGE widened to TEXT for CockroachDB. It is Batch-owned schema,
             not hand-authored DDL; typed Liquibase tags cannot reproduce the framework's exact
             table/sequence shapes byte-for-byte. Same pattern as prg/mrr 002-batch-metadata.xml. -->
        <sqlFile path="db/changelog/2026/07/batch-metadata-mrg.sql" splitStatements="true"/>
    </changeSet>

</databaseChangeLog>

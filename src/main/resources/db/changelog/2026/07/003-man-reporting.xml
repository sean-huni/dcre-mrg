<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ===================================================================================
         V1 BASELINE (SCRUM-107, owner directive 2026-08-08).

         MRG mandate state-delta reporting tables in dcre_man: a report registry
         (replay-addressable by id), a per-mandate delivery ledger (the authority on what
         state was externally reported, DB-arbitrated auto-guard), and a per-mandate
         watermark (last reported state). Scoped clone of the COLLECTIONS report generator
         CRG's reporting stack (plan T14).

         NO onFail="MARK_RAN" GUARD APPEARS IN THIS FILE, and that is the point of the v1
         baseline. Every object here has exactly ONE creator, MRG, so on a database that is
         created fresh for the direct cut-over none of them can already exist. A guard would
         be pure decoration, and a decorative guard is worse than none: it reads as evidence
         that a second writer exists somewhere. The genuinely shared objects, which DO have
         other writers and DO keep their guards, are in 000 and 004, and each says which
         writer it converges with.

         The file also no longer carries the man_ext_status view. v1 never mints it, so the
         removal narrative and the teardown changesets that chased it are gone with it.
         =================================================================================== -->

    <changeSet id="003-man-report" author="dcre">
        <createTable tableName="man_report">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <!-- `type`, not `report_type`: a column never repeats its own host table's name
                 (rules/be/java/architecture.md, "Column & field naming"). SCHEDULED | HEARTBEAT. -->
            <column name="type" type="VARCHAR(12)"><constraints nullable="false"/></column>
            <column name="trigger_kind" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="window_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="file_name" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_man_report_file"/></column>
            <column name="job_name" type="VARCHAR(128)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="003-man-delivery-ledger" author="dcre">
        <createTable tableName="man_delivery_ledger">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="report_id" type="UUID"><constraints nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="mandate_ref" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="state" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="manual_ref" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="man_delivery_ledger" indexName="ix_man_ledger_report"><column name="report_id"/></createIndex>
    </changeSet>

    <changeSet id="003-man-ledger-auto-guard" author="dcre">
        <!-- LIQUIBASE-SQL-EXCEPTION: a PARTIAL unique index (WHERE clause) has no typed
             Liquibase tag; the auto-send guard must exclude manual_ref rows so a manual
             override bypasses the guard while still being ledgered (same shape as crg's
             uq_ledger_auto). Full business identity is (client, mandate_ref, state): never
             report the same mandate state twice, across restarts and racing windows alike.

             v1: no IF NOT EXISTS. MRG is the only creator of this index and its own history
             table already makes a re-run a no-op, so the clause guarded nothing that a v1
             database can reach. -->
        <sql>CREATE UNIQUE INDEX uq_man_ledger_auto ON man_delivery_ledger (client, mandate_ref, state) WHERE manual_ref IS NULL;</sql>
        <rollback>
            <dropIndex tableName="man_delivery_ledger" indexName="uq_man_ledger_auto"/>
        </rollback>
    </changeSet>

    <changeSet id="003-man-watermark" author="dcre">
        <createTable tableName="man_watermark">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="mandate_ref" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="last_state" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <!-- Full business identity (client, mandate_ref): the ON CONFLICT target of the
             guarded watermark UPSERT (NEVER UPSERT-on-PK, CRDB resolves that on the PK only). -->
        <addUniqueConstraint tableName="man_watermark" columnNames="client, mandate_ref" constraintName="uq_man_watermark_client_ref"/>
    </changeSet>

</databaseChangeLog>

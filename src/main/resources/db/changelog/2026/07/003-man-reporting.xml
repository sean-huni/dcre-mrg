<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- MRG mandate state-delta reporting tables (dcre_man). PRG clone scoped to
         mandates (plan T14): a report registry (replay-addressable by id), a
         per-mandate delivery ledger (the authority on what state was externally
         reported, DB-arbitrated auto-guard), a per-mandate watermark (last
         reported state), and the man_ext_status delta view that exposes the
         client dimension the frozen mandate projection lacks. -->

    <changeSet id="003-man-report" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="man_report"/></not></preConditions>
        <createTable tableName="man_report">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="report_type" type="VARCHAR(12)"><constraints nullable="false"/></column>
            <column name="trigger_kind" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="window_key" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="file_name" type="VARCHAR(128)"><constraints nullable="false" unique="true" uniqueConstraintName="uq_man_report_file"/></column>
            <column name="job_name" type="VARCHAR(128)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="003-man-delivery-ledger" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="man_delivery_ledger"/></not></preConditions>
        <createTable tableName="man_delivery_ledger">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="report_id" type="UUID"><constraints nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="mandate_ref" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="state" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="manual_ref" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="man_delivery_ledger" indexName="ix_man_ledger_report"><column name="report_id"/></createIndex>
    </changeSet>

    <changeSet id="003-man-ledger-auto-guard" author="dcre">
        <!-- LIQUIBASE-SQL-EXCEPTION: a PARTIAL unique index (WHERE clause) has no typed
             Liquibase tag; the auto-send guard must exclude manual_ref rows so a manual
             override bypasses the guard while still being ledgered (same shape as prg's
             uq_ledger_auto). Full business identity is (client, mandate_ref, state): never
             report the same mandate state twice, across restarts and racing windows alike. -->
        <sql>CREATE UNIQUE INDEX IF NOT EXISTS uq_man_ledger_auto ON man_delivery_ledger (client, mandate_ref, state) WHERE manual_ref IS NULL;</sql>
    </changeSet>

    <changeSet id="003-man-watermark" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="man_watermark"/></not></preConditions>
        <createTable tableName="man_watermark">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()"><constraints primaryKey="true" nullable="false"/></column>
            <column name="client" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="mandate_ref" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="last_state" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <!-- Full business identity (client, mandate_ref): the ON CONFLICT target of the
             guarded watermark UPSERT (NEVER UPSERT-on-PK, CRDB resolves that on the PK only). -->
        <addUniqueConstraint tableName="man_watermark" columnNames="client, mandate_ref" constraintName="uq_man_watermark_client_ref"/>
    </changeSet>

    <changeSet id="003-man-ext-status-view" author="dcre" runOnChange="true">
        <!-- Delta source: the mandate PROJECTION (000 core, mandate_ref + state) joined to the
             MRR spine header for the client dimension the frozen projection lacks. R-14
             (SPEC-MANDATES-FLOW:69): mandate_ref is unique scheme-wide and compounds the client,
             so client_token is invariant per mandate_ref and DISTINCT collapses the multi-entry
             (CREATE/AMEND/CANCEL) fan-out to exactly one row per mandate. Mirrors prg's
             ext_tx_status deriving client from tx_header.client_token. When MSR (T13) later
             carries client on the projection itself, this view collapses to a direct read. -->
        <createView viewName="man_ext_status" replaceIfExists="true"><![CDATA[
            SELECT DISTINCT h.client_token AS client, m.mandate_ref, m.state
            FROM mandate m
            JOIN mandate_request_entry e ON e.mandate_ref = m.mandate_ref
            JOIN mandate_request_header h ON h.arrival_id = e.arrival_id
        ]]></createView>
    </changeSet>

</databaseChangeLog>

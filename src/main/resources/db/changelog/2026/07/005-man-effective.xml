<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-91: the mandate FSM and its time transitions, computed. This is what R-09
         specified ("zero clock-driven writers, no sweep job") before the MSR projection
         and its msrExpiryJob/msrSuspendJob drifted in.

         mandate_override is the ONE surviving writer target in the mandate response leg.
         It exists only because the suspension signal (N consecutive failed collections)
         lives in a DIFFERENT database, dcre_col, and a CockroachDB view cannot span
         databases. Everything else is derived. Keep it that way: do not add columns here
         to cache derivable state.

         [!CONVENTION-OVERRIDE] Family-suite architectural consistency (engineering.md,
         "Family consistency beats local cleverness"): a new member of a family-suite copies
         the family's architecture, and the collections/payments response leg is per-leg
         readers plus a precedence VIEW with ZERO clock-driven writers, so MRG should run one
         clock job (the report window), not two. It runs two: the report window AND the
         suspension writer that feeds this table.

         Reason it is not expressible in the family shape: the suspension signal is N
         consecutive failed collection attempts, recorded in man_collection_outcome in
         dcre_col (A-70). CockroachDB views cannot span databases, so no view in dcre_man can
         read it and no amount of derivation reaches it. This is the MINIMAL deviation the
         rule allows: one narrow override sink carrying one signal, joined through a pick
         view, with every other state in the leg still derived. Everything else in the leg
         matches collections exactly.

         RETIREMENT CONDITION: the deviation disappears the moment that signal is colocated
         in dcre_man or projected into it (an outbox, a CDC feed, a cross-database replica of
         man_collection_outcome). At that point the suspension state derives like every other
         state, mandate_override and its clock-driven writer are deleted, and MRG drops back
         to the family's one clock job. Nothing else in this changelog is allowed to grow a
         second reason to keep the writer alive. -->

    <changeSet id="005-mandate-override" author="dcre">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="mandate_override"/></not></preConditions>
        <createTable tableName="mandate_override">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mandate_ref" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="state" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(8)"/>
            <!-- VARCHAR(32), NOT the spec D5 sketch's VARCHAR(16): the spec names
                 COLLECTION_FAILURE as a source value in the same breath and that is 18
                 characters, so a 16-wide column rejects the one value the override writer
                 (Task 7, absorbed from msrSuspendJob) exists to write. Caught red by
                 MandateEffectiveStatusIT: value too long for type VARCHAR(16). -->
            <column name="source" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="effective_from" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
        </createTable>
        <!-- FULL business identity (mandate_ref, source): the ON CONFLICT target of the
             guarded override UPSERT. Never UPSERT on the PK (CRDB resolves that on the PK
             only). Keying on mandate_ref alone would let an ops override and a collection
             failure clobber each other. -->
        <addUniqueConstraint tableName="mandate_override" columnNames="mandate_ref, source"
                             constraintName="uq_mandate_override_ref_source"/>
    </changeSet>

    <!-- Index-backed override pick window, created BEFORE the view that reads it (same
         contract as 004's ix_man_*_pick): (partition key, then the ORDER BY leader
         descending) so CRDB reads the window in index order instead of sorting the table.
         mandate_effective_status is on CTV's hot path, so this goes in up front. -->
    <changeSet id="005-ix-mandate-override-pick" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="mandate_override" indexName="ix_mandate_override_pick"/></not>
        </preConditions>
        <createIndex tableName="mandate_override" indexName="ix_mandate_override_pick">
            <column name="mandate_ref"/>
            <column name="effective_from" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ONE winning override per mandate, the same latest-row-wins shape the leg pick views
         use. This view is REQUIRED, not cosmetic: the unique key on mandate_override is the
         FULL business identity (mandate_ref, source), so a mandate legitimately carries an
         OPS override AND a COLLECTION_FAILURE override at once. Joining the TABLE from
         mandate_effective_status fans that out to one row PER OVERRIDE per spine entry, so
         man_ctv_view would hand CTV two rows for one mandate and MRG would report the mandate
         twice in a single window. Narrowing the unique key to mandate_ref is NOT the fix: it
         would let the two sources clobber each other, which is the subset-key defect the
         idempotency rule forbids. Collapse at READ time instead.

         effective_from DESC picks the newest override; source ASC is the deterministic
         tie-break for two overrides sharing an effective_from. Without that second key the
         winner is whichever row CRDB happens to rank first, so the same mandate could read
         SUSPENDED on one scan and CANC on the next. -->
    <changeSet id="005-mandate-override-pick" author="dcre" runOnChange="true">
        <createView viewName="mandate_override_pick" replaceIfExists="true"><![CDATA[
            SELECT u.mandate_ref, u.state, u.reason
            FROM (SELECT o.mandate_ref, o.state, o.reason,
                         row_number() OVER (PARTITION BY o.mandate_ref
                                            ORDER BY o.effective_from DESC,
                                                     o.source ASC) AS pick_rank
                  FROM mandate_override o) AS u
            WHERE u.pick_rank = 1
        ]]></createView>
    </changeSet>

    <!-- The FSM, verbatim from MSR's deleted MandateStateMachine. Precedence order in the
         CASE is load-bearing:

         1. An explicit override wins outright (R-09: explicit records beat the derived
            value). It is the only cross-database signal, so nothing derived here can
            contradict it. The join goes through mandate_override_pick, never the table:
            see that changeset for why the table join is a row fan-out.
         2. A leg RJCT/CANC is terminal wherever it came from.
         3. A REQUEST-leg rejection (stage_rank 1, an MRV outcome that is neither MRV_PASS
            nor the no-verdict-yet PDNG) is terminal too. This arm covers the MRR B1a
            dup_in_file entry whose mndt_req_id is NULL: it never reached Fintegrate and can
            NEVER receive a leg response, so without this it would sit PDNG forever, be
            reported as pending indefinitely, and be counted as a LIVE twin by the 1:1-live
            admission check, blocking a legitimate re-registration of that contract. It sits
            AHEAD of the expiry arm because a request-leg rejection is decided before any
            date predicate can apply.
         4. Expiry, as a PREDICATE over the spine's CCYYMMDD VARCHAR(8) (never a written
            state): to_date guarded against the empty string MRR writes for "no expiry".
            NOTE (A-64): CTV reads man_ctv_view AS OF SYSTEM TIME, so current_date evaluates
            at the SNAPSHOT, not wall clock. That is correct for an admissibility gate
            deciding as of the instant it pinned. Never "fix" this into a written column.
         5. Only a PBSR ACCP (stage_rank 4) yields ACCP. An ISR or SBSR ACCP means the
            instruction passed that stage but the debtor has not authenticated yet.

         no_retry derives from the mandate_reason_code reference table's system_action
         (R-21: codes in tables, never enums), so retry policy is reference-data-driven.

         GRAIN (D5b, 2026-07-25): this view is per INSTRUCTION, not per mandate. The spine
         is keyed (arrival_id, sequence) with NO uniqueness on mandate_ref, so a mandate
         with a CREATE, an AMEND and a CANCEL has three rows here, each with its own state.
         That is the correct grain for reporting what happened to each instruction, and it
         is the exact mirror of collections' ext_tx_status. Consumers that need ONE row per
         mandate (CTV, the 1:1-live check, the parity gate) read mandate_current_status
         (007), which collapses these rows through the FSM. action_code is carried for
         per-INSTRUCTION reporting only, and is deliberately NOT used by the 007 collapse:
         rejection is mandate-scoped there (Sean ruling, 2026-07-26; see 007's arm 4).

         reason is published RAW here, and the "ACCP implies no reason" invariant is
         deliberately NOT applied at this grain (reverted 2026-07-26). That invariant is about
         THE MANDATE, so it belongs in 007, which sanitises in its OUTER projection after the
         aggregate has already computed the state. Nulling reason here instead blinds 007's
         arm 1: it reads bool_or(rc.system_action = 'TERMINATE_NOW') over a join
         ON rc.code = m.reason against THIS view, so a PBSR ACCP carrying MD07 (end customer
         deceased) arrived with reason NULL, arm 1 never fired, and the mandate read ACCP
         instead of RJCT. That is a fail-open on a termination. Pinned by
         MandateCurrentStatusIT.anAcceptedLegCarryingATerminateNowReasonStillReadsRjct. -->

    <changeSet id="005-mandate-effective-status" author="dcre" runOnChange="true">
        <createView viewName="mandate_effective_status" replaceIfExists="true"><![CDATA[
            SELECT x.client,
                   x.mandate_ref,
                   x.mndt_req_id,
                   x.contract_ref,
                   x.debtor_account,
                   x.creditor_account,
                   x.max_collection_amount,
                   x.start_date,
                   x.expiry_date,
                   x.raw_status,
                   x.stage_rank,
                   CASE
                     WHEN o.state IS NOT NULL                        THEN o.state
                     WHEN x.raw_status = 'RJCT'                      THEN 'RJCT'
                     WHEN x.raw_status = 'CANC'                      THEN 'CANC'
                     WHEN x.stage_rank = 1
                          AND x.raw_status NOT IN ('MRV_PASS', 'PDNG')
                                                                     THEN 'RJCT'
                     WHEN x.stage_rank = 4 AND x.raw_status = 'ACCP'
                          AND x.expiry_date IS NOT NULL AND x.expiry_date <> ''
                          AND to_date(x.expiry_date, 'YYYYMMDD') < current_date
                                                                     THEN 'EXPIRED'
                     WHEN x.stage_rank = 4 AND x.raw_status = 'ACCP' THEN 'ACCP'
                     ELSE 'PDNG'
                   END AS state,
                   COALESCE(o.reason, x.reason) AS reason,
                   COALESCE(rc.system_action IN ('NO_RETRY', 'PERMANENT_FAIL'), false) AS no_retry,
                   x.action_code
            FROM mnd_ext_status x
            LEFT JOIN mandate_override_pick o ON o.mandate_ref = x.mandate_ref
            LEFT JOIN mandate_reason_code rc ON rc.code = COALESCE(o.reason, x.reason)
        ]]></createView>
    </changeSet>

    <!-- CRDB CREATE OR REPLACE VIEW cannot reorder or insert columns, and man_ctv_view is
         being redefined over a different source. Drop it first under a viewExists guard so
         the upgrade order is deterministic on every CRDB line. This drops the MSR-era view;
         man_ctv_view is RECREATED in 007 over mandate_current_status, with an IDENTICAL
         column list, so CTV needs no code change.

         The definition deliberately does NOT live here any more (D5b): it must read the
         per-mandate collapse, and that view does not exist yet at this point in the
         changelog. Keeping a definition here as well would leave man_ctv_view pointing at
         the INSTRUCTION-grain view whenever this file's runOnChange changesets re-run
         without 007's also re-running, which is exactly the N-rows-per-mandate defect. -->
    <changeSet id="005-drop-man-ctv-view-v1" author="dcre">
        <preConditions onFail="MARK_RAN"><viewExists viewName="man_ctv_view"/></preConditions>
        <dropView viewName="man_ctv_view"/>
    </changeSet>

</databaseChangeLog>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- V1 BASELINE (SCRUM-107, owner directive 2026-08-08). Plain numeric include order.

         The previous master opened with a teardown file (006-drop-man-ext-status) deliberately
         included AHEAD of the shared core, because the drop of the `mandate` projection at 000
         was refused by CockroachDB while a view still selected from the table. Both files are
         gone: v1 never mints the projection and never mints man_ext_status, so there is nothing
         to retire and nothing to order around. 009-drop-mandate-projection went with them.

         Numbering 006 and 009 are deliberately left unused rather than renumbering 007 and 008.
         Renumbering would rewrite the filenames, and changeset identity is (id, author,
         FILENAME): the gaps cost nothing and keep every id stable against the copies MRV holds
         in its drift fixture. -->

    <include file="db/changelog/2026/07/000-man-core-bootstrap.xml"/>
    <include file="db/changelog/2026/07/001-man-spine-bootstrap.xml"/>
    <include file="db/changelog/2026/07/002-batch-metadata.xml"/>
    <include file="db/changelog/2026/07/003-man-reporting.xml"/>
    <include file="db/changelog/2026/07/004-man-views.xml"/>
    <include file="db/changelog/2026/07/005-man-effective.xml"/>
    <include file="db/changelog/2026/07/007-man-current-status.xml"/>
    <include file="db/changelog/2026/07/008-man-status-history.xml"/>

</databaseChangeLog>
